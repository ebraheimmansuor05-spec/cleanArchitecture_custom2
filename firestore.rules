rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isWorkshopOwner(workshopId) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/workshops/$(workshopId)
        )
        && get(
          /databases/$(database)/documents/workshops/$(workshopId)
        ).data.ownerId == request.auth.uid;
    }

    match /workshops/{workshopId} {

      allow read: if isWorkshopOwner(workshopId);

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if isWorkshopOwner(workshopId);

      match /members/{memberId} {

        allow read: if isWorkshopOwner(workshopId);

        allow create, update, delete: if false;
      }

      match /roles/{roleId} {

        allow read: if isWorkshopOwner(workshopId);

        allow create, update, delete: if false;
      }
    }

    match /workshop_users/{workshopUserId} {

      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isWorkshopOwner(resource.data.workshopId)
        );

      allow create, update, delete: if false;
    }

    match /roles/{roleId} {

      allow read: if isSignedIn()
        && isWorkshopOwner(resource.data.workshopId);

      allow create, update, delete: if false;
    }
  }
}